# ─── Secrets — safety net ────────────────────────────────────────────────────
# Toki never reads these, and nothing here should ever exist in the repo. The
# patterns are kept so an accidental copy cannot be committed by mistake.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.der
*.keystore
*.jks
*.keychain
*.keychain-db
*.mobileprovision
*.provisionprofile
id_rsa*
id_ecdsa*
id_ed25519*
*.ppk
.netrc
.npmrc
auth.json
credentials
credentials.json
secrets.json
secrets.yaml
serviceAccount*.json
*_rsa
*_dsa

